# ─────────────────────────────────────────────
# Vestura VTON — Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env or real API keys to version control.

# ── Mode Selection ────────────────────────────
# Mode to default to: "cloud" or "local"
AI_MODE=cloud

# ── Mode 1: Local / Free Settings ────────────
# URL of your local CatVTON or PyTorch inference worker.
# Start local worker with: python scripts/local_vton_server.py
LOCAL_VTON_URL=http://127.0.0.1:7860

# ── Mode 2: Cloud Settings ────────────────────
# Supported Cloud Providers: "gemini", "replicate", "custom"
AI_PROVIDER=gemini

# 1. Google Gemini (VTON Native)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash-preview-0514

# 2. Replicate API (IDM-VTON / CatVTON models)
# REPLICATE_API_KEY=r8_your_replicate_token_here
# REPLICATE_MODEL=yisol/idm-vton

# 3. Custom VTON API Settings
# CUSTOM_PROVIDER_ENDPOINT=https://your-vton-api.com/v1/try-on
# CUSTOM_PROVIDER_API_KEY=your_custom_api_key
# CUSTOM_PROVIDER_MODEL=your-model-id

# ── Server Settings ───────────────────────────
# HTTP port for the web application
PORT=3000

# Node Environment ("development" or "production")
# NODE_ENV=production
